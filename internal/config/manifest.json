{
  "default_days": 7.0,
  "default_min_size_mb": 0.0,
  "rules": [
    {
      "id": "zig_cache",
      "name": "Zig Build Cache",
      "target": "dir",
      "patterns": [".zig-cache", "zig-cache", ".clear-cache", "clear-cache", ".clear-transpile-cache"],
      "category": "Cache Dir",
      "risk_class": "regenerable"
    },
    {
      "id": "rust_target",
      "name": "Cargo Build Target",
      "target": "dir",
      "patterns": ["target"],
      "category": "Rust Target",
      "marker_files": ["Cargo.toml"],
      "risk_class": "regenerable"
    },
    {
      "id": "node_modules_cache",
      "name": "Node Modules Cache",
      "target": "dir",
      "patterns": ["node_modules/.cache"],
      "category": "Cache Dir",
      "risk_class": "regenerable"
    },
    {
      "id": "node_modules",
      "name": "Node Modules Dependencies",
      "target": "dir",
      "patterns": ["node_modules"],
      "category": "Node Modules",
      "marker_files": ["package.json"],
      "risk_class": "regenerable"
    },
    {
      "id": "python_venv",
      "name": "Python Virtual Environment",
      "target": "dir",
      "patterns": ["venv", ".venv", "env"],
      "category": "Python Venv",
      "marker_files": ["pyproject.toml", "requirements.txt", "Pipfile", "setup.py", "environment.yml"],
      "internal_marker_files": ["pyvenv.cfg"],
      "risk_class": "regenerable"
    },
    {
      "id": "gradle_build",
      "name": "Gradle Build Cache",
      "target": "dir",
      "patterns": [".gradle", "build"],
      "category": "Gradle Cache",
      "marker_files": ["build.gradle", "build.gradle.kts", "settings.gradle", "gradlew"],
      "risk_class": "regenerable"
    },
    {
      "id": "maven_build",
      "name": "Maven Build Target",
      "target": "dir",
      "patterns": [".m2", "target"],
      "category": "Maven Target",
      "marker_files": ["pom.xml"],
      "risk_class": "regenerable"
    },
    {
      "id": "tool_cache_tmp",
      "name": "Known Tool Cache Temp",
      "target": "dir",
      "patterns": ["*/.cache/*", "*/.local/tmp/*", "*/.cargo/tmp/*"],
      "category": "Tool Temp Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "llm_models",
      "name": "LLM Models & Weights",
      "target": "any",
      "patterns": ["*.gguf", "*.safetensors", "*.ckpt", "*.gexf", "*.llamafile", ".ollama/models", ".cache/huggingface/hub", ".lmstudio/models", ".cache/lm-studio", "jan/models", ".cache/llama.cpp"],
      "category": "LLM Model",
      "risk_class": "user-data"
    },
    {
      "id": "agent_sessions",
      "name": "AI Agent Sessions",
      "target": "any",
      "patterns": ["rollout-*.jsonl", ".codex/sessions", ".gemini/antigravity-cli/conversations"],
      "category": "Agent Session",
      "risk_class": "user-data"
    },
    {
      "id": "cursor_workspace_storage",
      "name": "Cursor Workspace Storage",
      "target": "dir",
      "patterns": [".config/Cursor/User/workspaceStorage"],
      "category": "Cursor Workspace Storage",
      "risk_class": "user-data"
    },
    {
      "id": "agent_cache",
      "name": "AI Agent Caches",
      "target": "dir",
      "patterns": [".codex/cache", ".codex/tmp", ".codex/.tmp", ".claude/cache", ".claude/paste-cache", ".gemini/antigravity-cli/cache", ".gemini/antigravity-cli/implicit", ".config/Cursor/Cache", ".config/Cursor/GPUCache"],
      "category": "Agent Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "agent_logs",
      "name": "AI Agent Logs",
      "target": "any",
      "patterns": [".claude/debug", ".gemini/antigravity-cli/log", ".gemini/antigravity-cli/crashes", ".config/Cursor/logs"],
      "category": "Agent Log",
      "risk_class": "user-data"
    },
    {
      "id": "agent_history",
      "name": "AI Agent File History",
      "target": "any",
      "patterns": [".claude/file-history"],
      "category": "Agent History",
      "risk_class": "user-data"
    },
    {
      "id": "json_artifacts",
      "name": "Large JSON Dumps",
      "target": "file",
      "patterns": ["*.json", "*.jsonl"],
      "category": "JSON Artifact",
      "min_size_mb": 5.0,
      "risk_class": "user-data"
    },
    {
      "id": "profile_data",
      "name": "Profile & Trace Dumps",
      "target": "file",
      "patterns": ["*.profile", "*.pprof", "perf.data*", "*.cpuprofile", "*.heapprofile", "*profile*.json", "*.trace", "trace*.err", "*.dmp", "bench.profile"],
      "category": "Profile/Trace",
      "risk_class": "user-data"
    },
    {
      "id": "log_files",
      "name": "Log Files",
      "target": "file",
      "patterns": ["*.log", "*.err", "*.out"],
      "category": "Log File",
      "risk_class": "user-data"
    },
    {
      "id": "generic_temp_files",
      "name": "Generic Temp Files",
      "target": "file",
      "patterns": ["*.ll", "*.bc", "*.tmp", "*.temp"],
      "category": "Generic Temp File",
      "risk_class": "unknown"
    },
    {
      "id": "cargo_pkg",
      "name": "Unused Cargo Package",
      "target": "file",
      "patterns": ["*/.cargo/bin/*"],
      "category": "UNUSED (Cargo)",
      "check_unused_atime": true,
      "risk_class": "package-managed"
    },
    {
      "id": "npm_pkg",
      "name": "Unused npm Package",
      "target": "file",
      "patterns": ["*/.nvm/versions/node/*/bin/*", "*/.npm-global/bin/*", "*/.config/nvm/*/bin/*"],
      "category": "UNUSED (npm)",
      "check_unused_atime": true,
      "risk_class": "package-managed"
    },
    {
      "id": "pipx_pkg",
      "name": "Unused pipx Package",
      "target": "file",
      "patterns": ["*/.local/pipx/venvs/*", "*/.local/bin/*"],
      "category": "UNUSED (pipx)",
      "check_unused_atime": true,
      "risk_class": "package-managed"
    },
    {
      "id": "swift_toolchain",
      "name": "Unused Swift Toolchain",
      "target": "dir",
      "patterns": ["*/.local/share/swiftly/toolchains/*"],
      "category": "UNUSED (Swift)",
      "risk_class": "package-managed"
    },
    {
      "id": "sdkman_cand",
      "name": "Unused SDKMAN Candidate",
      "target": "dir",
      "patterns": ["*/.sdkman/candidates/*/*"],
      "category": "UNUSED (SDKMAN)",
      "risk_class": "package-managed"
    },
    {
      "id": "dotnet_pkg",
      "name": "Unused .NET Tool",
      "target": "file",
      "patterns": ["*/.dotnet/tools/*"],
      "category": "UNUSED (Dotnet)",
      "check_unused_atime": true,
      "risk_class": "package-managed"
    },
    {
      "id": "composer_pkg",
      "name": "Unused Composer Package",
      "target": "file",
      "patterns": ["*/.config/composer/vendor/bin/*", "*/.composer/vendor/bin/*"],
      "category": "UNUSED (Composer)",
      "check_unused_atime": true,
      "risk_class": "package-managed"
    },
    {
      "id": "zvm_toolchain",
      "name": "Unused Zig Toolchain",
      "target": "any",
      "patterns": ["*/.zvm/bin/*", "*/.zvm/zig/*"],
      "category": "UNUSED (ZVM)",
      "risk_class": "package-managed"
    },
    {
      "id": "unity_build",
      "name": "Unused Unity Build Artifacts",
      "target": "dir",
      "patterns": ["Library", "Temp", "Obj"],
      "marker_files": ["Assets"],
      "category": "Build Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "unreal_build",
      "name": "Unused Unreal Engine Build Artifacts",
      "target": "dir",
      "patterns": ["Intermediate", "Saved", "DerivedDataCache"],
      "marker_files": ["Config"],
      "category": "Build Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "godot_cache",
      "name": "Unused Godot 4.x Import Cache",
      "target": "dir",
      "patterns": [".godot"],
      "marker_files": ["project.godot"],
      "category": "Build Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "turbo_cache",
      "name": "Unused Turborepo Cache",
      "target": "dir",
      "patterns": [".turbo"],
      "category": "Build Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "jupyter_checkpoints",
      "name": "Unused Jupyter Checkpoints",
      "target": "dir",
      "patterns": [".ipynb_checkpoints"],
      "category": "Notebook Checkpoint",
      "risk_class": "regenerable"
    },
    {
      "id": "elixir_build",
      "name": "Unused Elixir Mix Build Artifacts",
      "target": "dir",
      "patterns": ["_build"],
      "marker_files": ["mix.exs"],
      "category": "Build Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "terraform_cache",
      "name": "Unused Terraform Provider Cache",
      "target": "dir",
      "patterns": [".terraform"],
      "category": "Terraform Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "haskell_build",
      "name": "Unused Haskell Build Artifacts",
      "target": "dir",
      "patterns": [".stack-work", "dist-newstyle"],
      "category": "Build Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "dart_build",
      "name": "Unused Dart/Flutter Build Artifacts",
      "target": "dir",
      "patterns": [".dart_tool"],
      "category": "Build Cache",
      "risk_class": "regenerable"
    },
    {
      "id": "pixi_env",
      "name": "Unused Pixi Environment",
      "target": "dir",
      "patterns": [".pixi"],
      "category": "Virtual Environment",
      "risk_class": "regenerable"
    }
  ]
}
